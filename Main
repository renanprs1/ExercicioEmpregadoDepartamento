-- ================================================================
-- BASE DE DADOS DE EMPREGADOS E DEPARTAMENTOS (JDBC + POSTGRESQL)
-- Execute no psql:  psql -U postgres -f bddepartamentos.sql
-- (ou no pgAdmin: rode o CREATE DATABASE e depois as tabelas)
-- ================================================================

CREATE DATABASE bddepartamentos;

-- Conecta-se ao banco recém-criado (meta-comando do psql):
\c bddepartamentos

CREATE TABLE departamento (
    sigla    VARCHAR(10)  PRIMARY KEY,
    nome     VARCHAR(100) NOT NULL
);

CREATE TABLE empregado (
    cpf                VARCHAR(11)  PRIMARY KEY,
    nome               VARCHAR(100) NOT NULL,
    departamento_sigla VARCHAR(10)  NOT NULL,
    CONSTRAINT fk_empregado_departamento
        FOREIGN KEY (departamento_sigla) REFERENCES departamento (sigla)
);

-- Todo departamento pode ter um gerente, que é um empregado da empresa.
-- Por isso o relacionamento é circular (departamento -> empregado ->
-- departamento) e a coluna gerente_cpf é adicionada após as duas tabelas:
ALTER TABLE departamento
    ADD COLUMN gerente_cpf VARCHAR(11),
    ADD CONSTRAINT fk_departamento_gerente
        FOREIGN KEY (gerente_cpf) REFERENCES empregado (cpf);

package br.com.empresa.app;

import br.com.empresa.jdbc.DepartamentoDAO;
import br.com.empresa.jdbc.EmpregadoDAO;
import br.com.empresa.modelo.Departamento;
import br.com.empresa.modelo.Empregado;

import java.util.Scanner;

/**
 * Aplicação principal: sistema de gestão de empregados e departamentos.
 *
 * Requer o banco "bddepartamentos" criado conforme sql/bddepartamentos.sql
 * e o PostgreSQL acessível em localhost:5432.
 */
public class MainGestaoEmpresa {

    private static final Scanner SC = new Scanner(System.in);
    private static final EmpregadoDAO empregadoDAO = new EmpregadoDAO();
    private static final DepartamentoDAO departamentoDAO = new DepartamentoDAO();

    public static void main(String[] args) {
        int opcao = -1;
        while (opcao != 0) {
            exibirMenu();
            System.out.print("Opção: ");
            opcao = lerInteiro();
            SC.nextLine();

            switch (opcao) {
                case 1 -> cadastrarEmpregado();
                case 2 -> listarEmpregados();
                case 3 -> buscarEmpregado();
                case 4 -> alterarNomeEmpregado();
                case 5 -> transferirEmpregado();
                case 6 -> excluirEmpregado();
                case 7 -> listarEmpregadosDoDepartamento();
                case 8 -> cadastrarDepartamento();
                case 9 -> listarDepartamentos();
                case 10 -> buscarDepartamento();
                case 11 -> alterarNomeDepartamento();
                case 12 -> alocarGerente();
                case 13 -> removerGerente();
                case 14 -> excluirDepartamento();
                case 0 -> System.out.println("Encerrando aplicação...");
                default -> System.out.println("Opção inválida!");
            }

            if (opcao != 0) {
                System.out.println("\nPressione ENTER para continuar...");
                SC.nextLine();
            }
        }
        SC.close();
    }

    private static void exibirMenu() {
        System.out.println("\n============================================================");
        System.out.println("  SISTEMA DE GESTÃO - EMPREGADOS E DEPARTAMENTOS (JDBC)");
        System.out.println("============================================================");
        System.out.println("  EMPREGADOS");
        System.out.println("    [1]  Cadastrar empregado");
        System.out.println("    [2]  Listar todos os empregados");
        System.out.println("    [3]  Buscar empregado por CPF");
        System.out.println("    [4]  Alterar nome do empregado");
        System.out.println("    [5]  Transferir empregado para outro departamento");
        System.out.println("    [6]  Excluir empregado");
        System.out.println("    [7]  Listar empregados de um departamento");
        System.out.println("  DEPARTAMENTOS");
        System.out.println("    [8]  Cadastrar departamento");
        System.out.println("    [9]  Listar departamentos");
        System.out.println("    [10] Buscar departamento por sigla");
        System.out.println("    [11] Alterar nome do departamento");
        System.out.println("    [12] Alocar gerente a um departamento");
        System.out.println("    [13] Remover gerente do departamento");
        System.out.println("    [14] Excluir departamento");
        System.out.println("------------------------------------------------------------");
        System.out.println("    [0]  Sair");
    }

    // ---------------- EMPREGADOS ----------------

    private static void cadastrarEmpregado() {
        String cpf = lerCpf();
        System.out.print("Nome: ");
        String nome = SC.nextLine();
        System.out.print("Sigla do departamento: ");
        String sigla = SC.nextLine().trim().toUpperCase();

        if (departamentoDAO.buscarPorSigla(sigla) == null) {
            System.out.println(">>> Departamento inexistente. Cadastre-o primeiro (opção 8).");
            return;
        }
        boolean ok = empregadoDAO.inserir(new Empregado(cpf, nome, sigla));
        System.out.println(ok ? ">>> Empregado cadastrado com sucesso."
                : ">>> Falha ao cadastrar empregado (CPF já existente?).");
    }

    private static void listarEmpregados() {
        System.out.println("\n--- Todos os empregados (ordem alfabética) ---");
        empregadoDAO.listarTodos().forEach(System.out::println);
    }

    private static void buscarEmpregado() {
        String cpf = lerCpf();
        Empregado e = empregadoDAO.buscarPorCpf(cpf);
        System.out.println(e != null ? e : ">>> Empregado não encontrado.");
    }

    private static void alterarNomeEmpregado() {
        String cpf = lerCpf();
        if (empregadoDAO.buscarPorCpf(cpf) == null) {
            System.out.println(">>> Empregado não encontrado.");
            return;
        }
        System.out.print("Novo nome: ");
        String nome = SC.nextLine();
        boolean ok = empregadoDAO.atualizarNome(cpf, nome);
        System.out.println(ok ? ">>> Nome atualizado." : ">>> Falha ao atualizar.");
    }

    private static void transferirEmpregado() {
        String cpf = lerCpf();
        if (empregadoDAO.buscarPorCpf(cpf) == null) {
            System.out.println(">>> Empregado não encontrado.");
            return;
        }
        System.out.print("Nova sigla do departamento: ");
        String sigla = SC.nextLine().trim().toUpperCase();
        if (departamentoDAO.buscarPorSigla(sigla) == null) {
            System.out.println(">>> Departamento inexistente.");
            return;
        }
        boolean ok = empregadoDAO.transferirDepartamento(cpf, sigla);
        System.out.println(ok ? ">>> Empregado transferido." : ">>> Falha na transferência.");
    }

    private static void excluirEmpregado() {
        String cpf = lerCpf();
        if (ehGerente(cpf)) {
            System.out.println(">>> Empregado é gerente de um departamento. "
                    + "Remova-o da gerência antes (opção 13).");
            return;
        }
        boolean ok = empregadoDAO.excluir(cpf);
        System.out.println(ok ? ">>> Empregado excluído." : ">>> Empregado não encontrado.");
    }

    private static void listarEmpregadosDoDepartamento() {
        System.out.print("Sigla do departamento: ");
        String sigla = SC.nextLine().trim().toUpperCase();
        if (departamentoDAO.buscarPorSigla(sigla) == null) {
            System.out.println(">>> Departamento inexistente.");
            return;
        }
        System.out.println("\n--- Empregados do departamento " + sigla + " ---");
        empregadoDAO.listarPorDepartamento(sigla).forEach(System.out::println);
    }

    // ---------------- DEPARTAMENTOS ----------------

    private static void cadastrarDepartamento() {
        System.out.print("Sigla (ex.: VEN): ");
        String sigla = SC.nextLine().trim().toUpperCase();
        System.out.print("Nome: ");
        String nome = SC.nextLine();

        boolean ok = departamentoDAO.inserir(new Departamento(sigla, nome));
        System.out.println(ok ? ">>> Departamento cadastrado com sucesso."
                : ">>> Falha ao cadastrar departamento (sigla já existente?).");
    }

    private static void listarDepartamentos() {
        System.out.println("\n--- Todos os departamentos (ordem alfabética) ---");
        departamentoDAO.listarTodos().forEach(System.out::println);
    }

    private static void buscarDepartamento() {
        System.out.print("Sigla do departamento: ");
        String sigla = SC.nextLine().trim().toUpperCase();
        Departamento d = departamentoDAO.buscarPorSigla(sigla);
        System.out.println(d != null ? d : ">>> Departamento não encontrado.");
    }

    private static void alterarNomeDepartamento() {
        System.out.print("Sigla do departamento: ");
        String sigla = SC.nextLine().trim().toUpperCase();
        if (departamentoDAO.buscarPorSigla(sigla) == null) {
            System.out.println(">>> Departamento não encontrado.");
            return;
        }
        System.out.print("Novo nome: ");
        String nome = SC.nextLine();
        boolean ok = departamentoDAO.atualizarNome(sigla, nome);
        System.out.println(ok ? ">>> Nome atualizado." : ">>> Falha ao atualizar.");
    }

    private static void alocarGerente() {
        System.out.print("Sigla do departamento: ");
        String sigla = SC.nextLine().trim().toUpperCase();
        if (departamentoDAO.buscarPorSigla(sigla) == null) {
            System.out.println(">>> Departamento inexistente.");
            return;
        }
        String cpfGerente = lerCpf();
        if (empregadoDAO.buscarPorCpf(cpfGerente) == null) {
            System.out.println(">>> Empregado (CPF) inexistente.");
            return;
        }
        boolean ok = departamentoDAO.alocarGerente(sigla, cpfGerente);
        System.out.println(ok
                ? ">>> Gerente alocado ao departamento " + sigla + "."
                : ">>> Falha ao alocar gerente.");
    }

    private static void removerGerente() {
        System.out.print("Sigla do departamento: ");
        String sigla = SC.nextLine().trim().toUpperCase();
        boolean ok = departamentoDAO.removerGerente(sigla);
        System.out.println(ok
                ? ">>> Gerente removido do departamento " + sigla + "."
                : ">>> Departamento não encontrado.");
    }

    private static void excluirDepartamento() {
        System.out.print("Sigla do departamento: ");
        String sigla = SC.nextLine().trim().toUpperCase();
        if (!empregadoDAO.listarPorDepartamento(sigla).isEmpty()) {
            System.out.println(">>> Departamento possui empregados. "
                    + "Transfira ou exclua-os antes (opções 5/6).");
            return;
        }
        boolean ok = departamentoDAO.excluir(sigla);
        System.out.println(ok ? ">>> Departamento excluído." : ">>> Departamento não encontrado.");
    }

    // ---------------- UTILITÁRIOS ----------------

    /** Verifica se o CPF é gerente de algum departamento. */
    private static boolean ehGerente(String cpf) {
        return departamentoDAO.listarTodos().stream()
                .anyMatch(d -> cpf.equals(d.getGerenteCpf()));
    }

    /** Lê CPF e normaliza para apenas dígitos (aceita 123.456.789-01). */
    private static String lerCpf() {
        while (true) {
            System.out.print("CPF (somente dígitos ou formatado): ");
            String cpf = SC.nextLine().replaceAll("\\D", "");
            if (cpf.length() == 11) {
                return cpf;
            }
            System.out.println(">>> CPF inválido. Informe 11 dígitos.");
        }
    }

    private static int lerInteiro() {
        while (!SC.hasNextInt()) {
            System.out.print("Valor inválido. Digite um inteiro: ");
            SC.next();
        }
        return SC.nextInt();
    }
}

package br.com.empresa.jdbc;

import br.com.empresa.modelo.Departamento;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

/**
 * Camada de persistência (DAO) de departamentos, incluindo a alocação de
 * gerentes (departamento.gerente_cpf -> empregado.cpf).
 */
public class DepartamentoDAO {

    public boolean inserir(Departamento departamento) {
        String sql = "INSERT INTO departamento (sigla, nome) VALUES (?, ?)";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, departamento.getSigla());
            comando.setString(2, departamento.getNome());
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao inserir departamento: " + e.getMessage());
            return false;
        }
    }

    public boolean atualizarNome(String sigla, String novoNome) {
        String sql = "UPDATE departamento SET nome = ? WHERE sigla = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, novoNome);
            comando.setString(2, sigla);
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao atualizar departamento: " + e.getMessage());
            return false;
        }
    }

    public boolean alocarGerente(String sigla, String cpfGerente) {
        String sql = "UPDATE departamento SET gerente_cpf = ? WHERE sigla = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, cpfGerente);
            comando.setString(2, sigla);
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            // A FK fk_departamento_gerente impede um CPF inexistente
            System.err.println("Falha ao alocar gerente: " + e.getMessage());
            return false;
        }
    }

    public boolean removerGerente(String sigla) {
        String sql = "UPDATE departamento SET gerente_cpf = NULL WHERE sigla = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, sigla);
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao remover gerente: " + e.getMessage());
            return false;
        }
    }

    public boolean excluir(String sigla) {
        String sql = "DELETE FROM departamento WHERE sigla = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, sigla);
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            // A FK fk_empregado_departamento impede excluir depto com empregados
            System.err.println("Falha ao excluir departamento: " + e.getMessage());
            return false;
        }
    }

    public Departamento buscarPorSigla(String sigla) {
        String sql = "SELECT d.sigla, d.nome, d.gerente_cpf, e.nome "
                + "FROM departamento d "
                + "LEFT JOIN empregado e ON d.gerente_cpf = e.cpf "
                + "WHERE d.sigla = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, sigla);
            try (ResultSet rs = comando.executeQuery()) {
                if (rs.next()) {
                    return mapear(rs);
                }
            }
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao buscar departamento: " + e.getMessage());
        }
        return null;
    }

    public List<Departamento> listarTodos() {
        String sql = "SELECT d.sigla, d.nome, d.gerente_cpf, e.nome "
                + "FROM departamento d "
                + "LEFT JOIN empregado e ON d.gerente_cpf = e.cpf "
                + "ORDER BY d.nome ASC";
        List<Departamento> departamentos = new ArrayList<>();
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql);
             ResultSet rs = comando.executeQuery()) {

            while (rs.next()) {
                departamentos.add(mapear(rs));
            }
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao listar departamentos: " + e.getMessage());
        }
        return departamentos;
    }

    private Departamento mapear(ResultSet rs) throws SQLException {
        Departamento d = new Departamento();
        d.setSigla(rs.getString(1));
        d.setNome(rs.getString(2));
        d.setGerenteCpf(rs.getString(3));
        d.setGerenteNome(rs.getString(4));
        return d;
    }
}

package br.com.empresa.jdbc;

import br.com.empresa.modelo.Empregado;

import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.ArrayList;
import java.util.List;

/**
 * Camada de persistência (DAO) de empregados. Usa PreparedStatement com
 * marcadores posicionais (?) para prevenir SQL Injection.
 */
public class EmpregadoDAO {

    public boolean inserir(Empregado empregado) {
        String sql = "INSERT INTO empregado (cpf, nome, departamento_sigla) "
                + "VALUES (?, ?, ?)";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, empregado.getCpf());
            comando.setString(2, empregado.getNome());
            comando.setString(3, empregado.getDepartamentoSigla());
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao inserir empregado: " + e.getMessage());
            return false;
        }
    }

    public boolean atualizarNome(String cpf, String novoNome) {
        String sql = "UPDATE empregado SET nome = ? WHERE cpf = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, novoNome);
            comando.setString(2, cpf);
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao atualizar empregado: " + e.getMessage());
            return false;
        }
    }

    public boolean transferirDepartamento(String cpf, String novaSigla) {
        String sql = "UPDATE empregado SET departamento_sigla = ? WHERE cpf = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, novaSigla);
            comando.setString(2, cpf);
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao transferir empregado: " + e.getMessage());
            return false;
        }
    }

    public boolean excluir(String cpf) {
        String sql = "DELETE FROM empregado WHERE cpf = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, cpf);
            return comando.executeUpdate() > 0;
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao excluir empregado: " + e.getMessage());
            return false;
        }
    }

    public Empregado buscarPorCpf(String cpf) {
        String sql = "SELECT e.cpf, e.nome, e.departamento_sigla, d.nome "
                + "FROM empregado e "
                + "JOIN departamento d ON e.departamento_sigla = d.sigla "
                + "WHERE e.cpf = ?";
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            comando.setString(1, cpf);
            try (ResultSet rs = comando.executeQuery()) {
                if (rs.next()) {
                    return mapear(rs);
                }
            }
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao buscar empregado: " + e.getMessage());
        }
        return null;
    }

    public List<Empregado> listarTodos() {
        String sql = "SELECT e.cpf, e.nome, e.departamento_sigla, d.nome "
                + "FROM empregado e "
                + "JOIN departamento d ON e.departamento_sigla = d.sigla "
                + "ORDER BY e.nome ASC";
        return executarConsulta(sql, null);
    }

    public List<Empregado> listarPorDepartamento(String sigla) {
        String sql = "SELECT e.cpf, e.nome, e.departamento_sigla, d.nome "
                + "FROM empregado e "
                + "JOIN departamento d ON e.departamento_sigla = d.sigla "
                + "WHERE d.sigla = ? "
                + "ORDER BY e.nome ASC";
        return executarConsulta(sql, sigla);
    }

    private List<Empregado> executarConsulta(String sql, String parametro) {
        List<Empregado> empregados = new ArrayList<>();
        try (Connection conexao = FabricaConexao.obterConexao();
             PreparedStatement comando = conexao.prepareStatement(sql)) {

            if (parametro != null) {
                comando.setString(1, parametro);
            }
            try (ResultSet rs = comando.executeQuery()) {
                while (rs.next()) {
                    empregados.add(mapear(rs));
                }
            }
        } catch (ClassNotFoundException | SQLException e) {
            System.err.println("Falha ao consultar empregados: " + e.getMessage());
        }
        return empregados;
    }

    private Empregado mapear(ResultSet rs) throws SQLException {
        Empregado e = new Empregado();
        e.setCpf(rs.getString(1));
        e.setNome(rs.getString(2));
        e.setDepartamentoSigla(rs.getString(3));
        e.setDepartamentoNome(rs.getString(4));
        return e;
    }
}

package br.com.empresa.jdbc;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

/**
 * Criação de conexões com o PostgreSQL.
 * Pode ser sobrescrito via argumentos JVM (-Djdbc.senha=... etc.).
 */
public class FabricaConexao {

    private static final String DRIVER =
            System.getProperty("jdbc.driver", "org.postgresql.Driver");
    private static final String URL =
            System.getProperty("jdbc.url", "jdbc:postgresql://localhost:5432/bddepartamentos");
    private static final String USUARIO =
            System.getProperty("jdbc.usuario", "postgres");
    private static final String SENHA =
            System.getProperty("jdbc.senha", "postgres");

    public static Connection obterConexao() throws ClassNotFoundException, SQLException {
        Class.forName(DRIVER);
        return DriverManager.getConnection(URL, USUARIO, SENHA);
    }
}

package br.com.empresa.modelo;

/**
 * Entidade Departamento mapeada a partir da tabela "departamento" do PostgreSQL.
 * O gerente (gerente_cpf) é um empregado da empresa, podendo ainda não existir.
 */
public class Departamento {

    private String sigla;
    private String nome;
    private String gerenteCpf;
    private String gerenteNome; // preenchido por LEFT JOIN (apenas exibição)

    public Departamento() {
    }

    public Departamento(String sigla, String nome) {
        this.sigla = sigla;
        this.nome = nome;
    }

    public String getSigla() {
        return sigla;
    }

    public void setSigla(String sigla) {
        this.sigla = sigla;
    }

    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public String getGerenteCpf() {
        return gerenteCpf;
    }

    public void setGerenteCpf(String gerenteCpf) {
        this.gerenteCpf = gerenteCpf;
    }

    public String getGerenteNome() {
        return gerenteNome;
    }

    public void setGerenteNome(String gerenteNome) {
        this.gerenteNome = gerenteNome;
    }

    @Override
    public String toString() {
        String gerente = "não definido";
        if (gerenteCpf != null) {
            gerente = gerenteCpf + (gerenteNome != null ? " (" + gerenteNome + ")" : "");
        }
        return String.format("Sigla: %-6s | Nome: %-20s | Gerente: %s", sigla, nome, gerente);
    }
}

package br.com.empresa.modelo;

/**
 * Entidade Empregado mapeada a partir da tabela "empregado" do PostgreSQL.
 */
public class Empregado {

    private String cpf;
    private String nome;
    private String departamentoSigla;
    private String departamentoNome; // preenchido por JOIN (apenas exibição)

    public Empregado() {
    }

    public Empregado(String cpf, String nome, String departamentoSigla) {
        this.cpf = cpf;
        this.nome = nome;
        this.departamentoSigla = departamentoSigla;
    }

    public String getCpf() {
        return cpf;
    }

    public void setCpf(String cpf) {
        this.cpf = cpf;
    }

    public String getNome() {
        return nome;
    }

    public void setNome(String nome) {
        this.nome = nome;
    }

    public String getDepartamentoSigla() {
        return departamentoSigla;
    }

    public void setDepartamentoSigla(String departamentoSigla) {
        this.departamentoSigla = departamentoSigla;
    }

    public String getDepartamentoNome() {
        return departamentoNome;
    }

    public void setDepartamentoNome(String departamentoNome) {
        this.departamentoNome = departamentoNome;
    }

    @Override
    public String toString() {
        String depto = departamentoSigla
                + (departamentoNome != null ? " (" + departamentoNome + ")" : "");
        return String.format("CPF: %-11s | Nome: %-20s | Departamento: %s",
                cpf, nome, depto);
    }
}
